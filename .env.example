# =========================================================================
# CashFlow Solution - Variaveis de Ambiente (.env.example)
# =========================================================================
# Copie este arquivo para .env e ajuste os valores conforme o ambiente:
# cp .env.example .env

# Credenciais de acesso ao broker RabbitMQ
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=cashflow_pass_local

# Seguranca OWASP: Chave de API para autenticacao nas APIs (X-Api-Key ou Bearer)
API_KEY=cashflow-secret-api-key-2026

# =========================================================================
# PostgreSQL 16 - Seguranca e Principio do Menor Privilegio (Least Privilege)
# =========================================================================
POSTGRES_DB=cashflow_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword

# Usuario de Escrita (Write-Side: Transactions API e Consolidated Worker)
DB_WRITER_USER=cashflow_writer
DB_WRITER_PASSWORD=writer_secret_pass_local

# Usuario de Leitura Estrita (Read-Side: Consolidated API - Apenas SELECT)
DB_READER_USER=cashflow_reader
DB_READER_PASSWORD=reader_secret_pass_local
