# =========================================================================
# CashFlow Solution - Variaveis de Ambiente (.env.example)
# =========================================================================
# Copie este arquivo para .env e ajuste os valores conforme o ambiente:
# cp .env.example .env

# Credenciais de acesso ao broker RabbitMQ
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=cashflow_pass_local

# Seguranca OWASP: Chave de API para autenticacao nas APIs (X-Api-Key ou Bearer)
API_KEY=cashflow-secret-api-key-2026
