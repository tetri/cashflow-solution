# Arquivo de Configuracao de Governanca e Analise Estatica de Codigo (Roslyn)
# Projeto: CashFlow Solution - Controle de Fluxo de Caixa (.NET 8 / C# 12)
# Conformidade: Requisitos R2, R3 e R4 (Estilo Estrito, Zero Emojis, pt-BR)

root = true

# ==============================================================================
# Configuracoes Globais para Todos os Arquivos
# ==============================================================================
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# ==============================================================================
# Arquivos de Configuracao Estruturada e Documentacao
# ==============================================================================
[*.{json,yml,yaml,xml,props,targets}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# ==============================================================================
# Regras de Codigo-Fonte C# (C# 12 / .NET 8)
# ==============================================================================
[*.cs]

# Preferencias de Namespace do C# 12 (File-Scoped Namespaces Obrigatorios)
csharp_style_namespace_declarations = file_scoped:error

# Preferencias de Nulabilidade
csharp_nullable_enable = true:error

# Formatacao e Controle de Fluxo (Uso Obrigatorio de Chaves)
csharp_prefer_braces = true:error

# Preferencias de Uso de 'var'
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Modificadores de Acesso e Ordem
dotnet_style_require_accessibility_modifiers = for_non_interface_members:error
csharp_preferred_modifier_order = public,private,protected,internal,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,volatile,async:suggestion
dotnet_style_readonly_field = true:suggestion

# Preferencias de Membros com Corpo de Expressao (Expression-Bodied Members)
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_constructors = false:suggestion
csharp_style_expression_bodied_operators = false:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_indexers = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion
csharp_style_expression_bodied_lambdas = true:suggestion
csharp_style_expression_bodied_local_functions = when_on_single_line:suggestion

# Preferencias de Pattern Matching (C# 9 a 12)
csharp_style_pattern_matching_over_is_syntax = true:suggestion
csharp_style_pattern_matching_over_as_syntax = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_prefer_not_pattern = true:suggestion
csharp_style_prefer_extended_property_pattern = true:suggestion

# Desqualificacao de 'this.' e 'Me.' (Codigo Limpo)
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

# ==============================================================================
# Convencoes de Nomenclatura (Roslyn Naming Rules)
# ==============================================================================

# 1. Tipos (Classes, Estruturas, Enums, Delegates, Records) -> PascalCase
dotnet_naming_rule.types_must_be_pascal_case.symbols = types_symbol
dotnet_naming_rule.types_must_be_pascal_case.style = pascal_case_style
dotnet_naming_rule.types_must_be_pascal_case.severity = error

dotnet_naming_symbols.types_symbol.applicable_kinds = class, struct, enum, delegate, record
dotnet_naming_symbols.types_symbol.applicable_accessibilities = *

# 2. Interfaces -> IPascalCase (Prefixo 'I' Obrigatorio)
dotnet_naming_rule.interfaces_must_start_with_i.symbols = interfaces_symbol
dotnet_naming_rule.interfaces_must_start_with_i.style = prefix_i_pascal_case_style
dotnet_naming_rule.interfaces_must_start_with_i.severity = error

dotnet_naming_symbols.interfaces_symbol.applicable_kinds = interface
dotnet_naming_symbols.interfaces_symbol.applicable_accessibilities = *

# 3. Parametros de Tipo Generico -> TPascalCase (Prefixo 'T' Obrigatorio)
dotnet_naming_rule.type_parameters_must_start_with_t.symbols = type_parameters_symbol
dotnet_naming_rule.type_parameters_must_start_with_t.style = prefix_t_pascal_case_style
dotnet_naming_rule.type_parameters_must_start_with_t.severity = error

dotnet_naming_symbols.type_parameters_symbol.applicable_kinds = type_parameter
dotnet_naming_symbols.type_parameters_symbol.applicable_accessibilities = *

# 4. Campos Privados de Instancia -> _camelCase (Prefixo '_' Obrigatorio)
dotnet_naming_rule.private_fields_must_start_with_underscore.symbols = private_fields_symbol
dotnet_naming_rule.private_fields_must_start_with_underscore.style = underscore_camel_case_style
dotnet_naming_rule.private_fields_must_start_with_underscore.severity = error

dotnet_naming_symbols.private_fields_symbol.applicable_kinds = field
dotnet_naming_symbols.private_fields_symbol.applicable_accessibilities = private

# 5. Constantes (Publicas, Privadas ou Internas) -> PascalCase
dotnet_naming_rule.constants_must_be_pascal_case.symbols = constants_symbol
dotnet_naming_rule.constants_must_be_pascal_case.style = pascal_case_style
dotnet_naming_rule.constants_must_be_pascal_case.severity = error

dotnet_naming_symbols.constants_symbol.applicable_kinds = field
dotnet_naming_symbols.constants_symbol.required_modifiers = const
dotnet_naming_symbols.constants_symbol.applicable_accessibilities = *

# 6. Propriedades -> PascalCase
dotnet_naming_rule.properties_must_be_pascal_case.symbols = properties_symbol
dotnet_naming_rule.properties_must_be_pascal_case.style = pascal_case_style
dotnet_naming_rule.properties_must_be_pascal_case.severity = error

dotnet_naming_symbols.properties_symbol.applicable_kinds = property
dotnet_naming_symbols.properties_symbol.applicable_accessibilities = *

# 7. Metodos -> PascalCase
dotnet_naming_rule.methods_must_be_pascal_case.symbols = methods_symbol
dotnet_naming_rule.methods_must_be_pascal_case.style = pascal_case_style
dotnet_naming_rule.methods_must_be_pascal_case.severity = error

dotnet_naming_symbols.methods_symbol.applicable_kinds = method
dotnet_naming_symbols.methods_symbol.applicable_accessibilities = *

# 8. Parametros de Metodos e Construtores -> camelCase
dotnet_naming_rule.parameters_must_be_camel_case.symbols = parameters_symbol
dotnet_naming_rule.parameters_must_be_camel_case.style = camel_case_style
dotnet_naming_rule.parameters_must_be_camel_case.severity = error

dotnet_naming_symbols.parameters_symbol.applicable_kinds = parameter
dotnet_naming_symbols.parameters_symbol.applicable_accessibilities = *

# 9. Variaveis Locais -> camelCase
dotnet_naming_rule.local_variables_must_be_camel_case.symbols = local_variables_symbol
dotnet_naming_rule.local_variables_must_be_camel_case.style = camel_case_style
dotnet_naming_rule.local_variables_must_be_camel_case.severity = error

dotnet_naming_symbols.local_variables_symbol.applicable_kinds = local
dotnet_naming_symbols.local_variables_symbol.applicable_accessibilities = *

# Definicoes de Estilos de Nomenclatura
dotnet_naming_style.pascal_case_style.capitalization = pascal_case
dotnet_naming_style.prefix_i_pascal_case_style.capitalization = pascal_case
dotnet_naming_style.prefix_i_pascal_case_style.required_prefix = I
dotnet_naming_style.prefix_t_pascal_case_style.capitalization = pascal_case
dotnet_naming_style.prefix_t_pascal_case_style.required_prefix = T
dotnet_naming_style.underscore_camel_case_style.capitalization = camel_case
dotnet_naming_style.underscore_camel_case_style.required_prefix = _
dotnet_naming_style.camel_case_style.capitalization = camel_case

# ==============================================================================
# Ajustes de Severidade de Diagnosticos Roslyn / Analisadores CA
# ==============================================================================

# Limpeza e formatacao estrita
dotnet_diagnostic.IDE0005.severity = error
dotnet_diagnostic.IDE0055.severity = error
dotnet_diagnostic.IDE0011.severity = error

# Analise de codigo estrita em producao
dotnet_diagnostic.CA1707.severity = error
dotnet_diagnostic.CA1822.severity = suggestion
dotnet_diagnostic.CA1848.severity = suggestion
dotnet_diagnostic.CA1873.severity = suggestion
dotnet_diagnostic.CA1031.severity = suggestion
dotnet_diagnostic.CA1303.severity = none
dotnet_diagnostic.CA1304.severity = suggestion
dotnet_diagnostic.CA1305.severity = suggestion
dotnet_diagnostic.CA1310.severity = suggestion
dotnet_diagnostic.CA1716.severity = none

# ==============================================================================
# Regras Especificas para Projetos de Teste
# ==============================================================================
[tests/**/*.cs]
# Permite sublinhados em metodos de teste (padrao Metodo_Cenario_ResultadoEsperado)
dotnet_diagnostic.CA1707.severity = none
# Nao exige que metodos de teste sem acesso a estado sejam estaticos
dotnet_diagnostic.CA1822.severity = none
# Nao exige documentacao XML em classes e metodos de teste
dotnet_diagnostic.CS1591.severity = none
# Permite classes aninhadas ou tipagens flexiveis em testes
dotnet_diagnostic.CA1034.severity = none
# Nao exige GenerateDocumentationFile para analise de usings em testes
dotnet_diagnostic.IDE0005.severity = none
